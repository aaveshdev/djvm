            base = args[0]; exp = args[1];
            if (exp == 0.0) { return 1.0; }
            if (base == 0.0) { return 0.0; }
            iexp = int(exp);
            if (iexp == exp and iexp > 0) {
                result = 1.0; i = 0; while (i < iexp) { result = result * base; i++; } return result;
            }
            if (base < 0.0) { return 0.0; }
            x = base; t = (x - 1.0) / (x + 1.0); t2 = t * t; lnx = 0.0; term = t; k = 1;
            while (k < 60) { lnx = lnx + term / k; term = term * t2; k = k + 2; }
            lnx = lnx * 2.0;
            y = exp * lnx; ey = 1.0; term2 = 1.0; i = 1;
