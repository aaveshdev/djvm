            while (i <= 30) { sinx = sinx + term; term = -term * x * x / ((2*i) * (2*i+1)); i++; }
            cosx = 0.0; term2 = 1.0; j = 1;
            while (j <= 30) { cosx = cosx + term2; term2 = -term2 * x * x / ((2*j-1) * (2*j)); j++; }
