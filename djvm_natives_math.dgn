            ln10t = 0.0; xt = (10.0 - 1.0) / (10.0 + 1.0); xt2 = xt * xt; termt = xt; kt = 1;
            while (kt < 80) { ln10t = ln10t + termt / kt; termt = termt * xt2; kt = kt + 2; }
